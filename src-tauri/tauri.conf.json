{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vuon Nha Nho",
  "version": "0.15.0",
  "identifier": "com.vuonnhanho.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vườn Nhà Nhỏ",
        "width": 1040,
        "height": 620,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  },
  "plugins": {
    "fs": {
      "scope": ["$APPDATA/*", "$APPDATA/**"]
    }
  }
}
